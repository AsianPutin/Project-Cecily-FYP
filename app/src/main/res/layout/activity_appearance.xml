<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- Top AppBarLayout -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/card_background" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/appearance_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Theme Mode Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Theme Mode"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Choose how the app looks on your device"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/themeToggleGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:singleSelection="true">

                        <Button
                            android:id="@+id/btnThemeAuto"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="System" />

                        <Button
                            android:id="@+id/btnThemeLight"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Light" />

                        <Button
                            android:id="@+id/btnThemeDark"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Dark" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Color Style Card (Default vs Material You) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Color Style"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Select custom color swatches or live wallpaper dynamic theme"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleColorStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <Button
                            android:id="@+id/btnStyleDefault"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:text="Default" />

                        <Button
                            android:id="@+id/btnStyleMaterialYou"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:text="Material You" />

                        <Button
                            android:id="@+id/btnStyleProfilePic"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:text="Profile Picture" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Accent Color Palette Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAccentPalette"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Accent Color"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Select an accent color scheme for buttons and highlights"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <!-- 6-Column x 3-Row Accent Color Palette Grid -->
                    <LinearLayout
                        android:id="@+id/layoutAccentGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical">

                        <!-- Row 1: None (X), Red, Orange, Yellow, Lime, Green -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <!-- Item 1: None (X) Reset -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/colorNone"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="#222222"
                                app:cardCornerRadius="14dp"
                                app:strokeWidth="0dp">
                                <ImageView
                                    android:id="@+id/iconNone"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Reset Color"
                                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                                    app:tint="#888888" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Red -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/colorRed"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="#E53935"
                                app:cardCornerRadius="14dp"
                                app:strokeWidth="0dp">
                                <ImageView
                                    android:id="@+id/checkRed"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check"
                                    android:visibility="gone" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Orange -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/colorOrange"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="#FB8C00"
                                app:cardCornerRadius="14dp"
                                app:strokeWidth="0dp">
                                <ImageView
                                    android:id="@+id/checkOrange"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check"
                                    android:visibility="gone" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Yellow -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/colorYellow"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="#FDD835"
                                app:cardCornerRadius="14dp"
                                app:strokeWidth="0dp">
                                <ImageView
                                    android:id="@+id/checkYellow"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check"
                                    android:visibility="gone" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Lime -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/colorLime"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="#C0CA33"
                                app:cardCornerRadius="14dp"
                                app:strokeWidth="0dp">
                                <ImageView
                                    android:id="@+id/checkLime"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check"
                                    android:visibility="gone" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Green -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/colorGreen"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="#4CAF50"
                                app:cardCornerRadius="14dp"
                                app:strokeWidth="0dp">
                                <ImageView
                                    android:id="@+id/checkGreen"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check"
                                    android:visibility="gone" />
                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                        <!-- Row 2: Dark Green, Mint, Teal, Cyan, Blue, Indigo -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">

                            <!-- Dark Green -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/colorDarkGreen"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="#2E7D32"
                                app:cardCornerRadius="14dp"
                                app:strokeWidth="0dp">
                                <ImageView
                                    android:id="@+id/checkDarkGreen"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check"
                                    android:visibility="gone" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Mint -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/colorMint"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="#00E676"
                                app:cardCornerRadius="14dp"
                                app:strokeWidth="0dp">
                                <ImageView
                                    android:id="@+id/checkMint"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check"
                                    android:visibility="gone" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Teal -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/colorTeal"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="#00897B"
                                app:cardCornerRadius="14dp"
                                app:strokeWidth="0dp">
                                <ImageView
                                    android:id="@+id/checkTeal"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check"
                                    android:visibility="gone" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Cyan -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/colorCyan"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="#00ACC1"
                                app:cardCornerRadius="14dp"
                                app:strokeWidth="0dp">
                                <ImageView
                                    android:id="@+id/checkCyan"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check"
                                    android:visibility="gone" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Blue -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/colorBlue"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="#1E88E5"
                                app:cardCornerRadius="14dp"
                                app:strokeWidth="0dp">
                                <ImageView
                                    android:id="@+id/checkBlue"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check"
                                    android:visibility="gone" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Indigo -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/colorIndigo"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="#3F51B5"
                                app:cardCornerRadius="14dp"
                                app:strokeWidth="0dp">
                                <ImageView
                                    android:id="@+id/checkIndigo"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check"
                                    android:visibility="gone" />
                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                        <!-- Row 3: Deep Purple, Purple, Magenta, Brown, Slate, Custom Picker -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">

                            <!-- Deep Purple -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/colorDeepPurple"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="#673AB7"
                                app:cardCornerRadius="14dp"
                                app:strokeWidth="0dp">
                                <ImageView
                                    android:id="@+id/checkDeepPurple"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check"
                                    android:visibility="gone" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Purple -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/colorPurple"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="#9C27B0"
                                app:cardCornerRadius="14dp"
                                app:strokeWidth="0dp">
                                <ImageView
                                    android:id="@+id/checkPurple"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check"
                                    android:visibility="gone" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Magenta -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/colorMagenta"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="#E91E63"
                                app:cardCornerRadius="14dp"
                                app:strokeWidth="0dp">
                                <ImageView
                                    android:id="@+id/checkMagenta"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check"
                                    android:visibility="gone" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Brown -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/colorBrown"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="#795548"
                                app:cardCornerRadius="14dp"
                                app:strokeWidth="0dp">
                                <ImageView
                                    android:id="@+id/checkBrown"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check"
                                    android:visibility="gone" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Slate -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/colorSlate"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="#546E7A"
                                app:cardCornerRadius="14dp"
                                app:strokeWidth="0dp">
                                <ImageView
                                    android:id="@+id/checkSlate"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check"
                                    android:visibility="gone" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Eyedropper Custom Picker -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/colorCustomPicker"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="#333333"
                                app:cardCornerRadius="14dp"
                                app:strokeWidth="0dp">
                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Custom Color Eyedropper"
                                    android:src="@android:drawable/ic_menu_edit"
                                    app:tint="#CCCCCC" />
                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Units & Measurement System Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUnitsMeasurement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="16dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Units &amp; Measurement"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Customize your preferred distance and temperature units"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <!-- Distance Unit Toggle Header -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Distance Unit"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleDistanceUnit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <Button
                            android:id="@+id/btnUnitMetric"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Metric (km)" />

                        <Button
                            android:id="@+id/btnUnitImperial"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Imperial (mi)" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <!-- Temperature Unit Toggle Header -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Temperature Unit"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleTemperatureUnit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <Button
                            android:id="@+id/btnTempCelsius"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Celsius (°C)" />

                        <Button
                            android:id="@+id/btnTempFahrenheit"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
