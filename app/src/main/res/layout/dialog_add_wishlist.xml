<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Item Name">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etItemName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Item Link (Optional)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etItemLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Media Source"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleMediaSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:checkedButton="@id/btnSourceUrl"
            app:singleSelection="true">

            <Button
                android:id="@+id/btnSourceUrl"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Web URL" />

            <Button
                android:id="@+id/btnSourceGallery"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Gallery" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- URL Input Section -->
        <LinearLayout
            android:id="@+id/layoutUrlInputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Image URL 1">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etImg1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>
            <!-- (Omitting others for brevity in dialog, usually 1 is enough for quick URL, but user asked for 3) -->
        </LinearLayout>

        <!-- Gallery Section -->
        <LinearLayout
            android:id="@+id/layoutGalleryInputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivSelect1"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="#DDDDDD"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_camera" />

            <ImageView
                android:id="@+id/ivSelect2"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:background="#DDDDDD"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_camera" />

            <ImageView
                android:id="@+id/ivSelect3"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="#DDDDDD"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_camera" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>