<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_ldr_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvWidgetHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Distance Apart"
        android:textColor="#AAAAAA"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvWidgetDistanceText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0.00 km"
        android:textColor="#25D366"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWidgetPartnerTimeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Partner's Time: --:--"
        android:textColor="#FF4081"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvWidgetPartnerLocationText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Fetching location..."
        android:textColor="#888888"
        android:textSize="11sp" />

</LinearLayout>