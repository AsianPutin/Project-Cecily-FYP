<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_ldr_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Text Line: [0000 km/mi] apart or We're together 💕 -->
    <TextView
        android:id="@+id/tvWidgetTopLine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="13120 km apart"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Middle Row: My Avatar, Dotted Heart Line, Partner Avatar -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivWidgetMyAvatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="My Avatar"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_blank_user" />

        <TextView
            android:id="@+id/tvWidgetDottedLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="------- 💕 -------"
            android:textColor="#FF4081"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/ivWidgetPartnerAvatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="Partner Avatar"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_blank_user" />

    </LinearLayout>

    <!-- Bottom Text Line: [00:00 (GMT)], city, country -->
    <TextView
        android:id="@+id/tvWidgetBottomLine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="06:52 (GMT), Kuching, Malaysia"
        android:textColor="#FFFFFF"
        android:textSize="11sp" />

</LinearLayout>