<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_ldr_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="3dp"
    android:paddingEnd="6dp"
    android:paddingBottom="3dp">

    <!-- Top Text Line: [0000 km/mi] apart or We're together 💕 -->
    <TextView
        android:id="@+id/tvWidgetTopLine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="13120 km apart"
        android:textColor="@color/widget_text_color"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Middle Row: My Avatar, Spaced Dual Color Dotted Line, Partner Avatar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/ivWidgetMyAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="My Avatar"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_blank_user" />

        <TextView
            android:id="@+id/tvLeftDottedLine"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="--------"
            android:textColor="#25D366"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvCenterHearts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:text="💕"
            android:textColor="#FF4081"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvRightDottedLine"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="--------"
            android:textColor="#FF4081"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/ivWidgetPartnerAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Partner Avatar"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_blank_user" />

    </LinearLayout>

    <!-- Bottom Text Line: [00:00 (GMT)], city, country -->
    <TextView
        android:id="@+id/tvWidgetBottomLine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="06:52 (GMT), Kuching, Malaysia"
        android:textColor="@color/widget_text_color"
        android:textSize="10sp" />

</LinearLayout>