<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_background"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Crop Profile Picture"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Drag and pinch to fit your face in the circle"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Crop Frame Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="#000000">

        <com.app.projectcecily.CropImageView
            android:id="@+id/ivCropTarget"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.app.projectcecily.CircularOverlayView
            android:id="@+id/circularOverlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Controls Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnRotateCrop"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rotate 90° 🔄" />

        <Button
            android:id="@+id/btnSaveCroppedPic"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:backgroundTint="#25D366"
            android:text="Save Picture"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>