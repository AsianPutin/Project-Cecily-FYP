<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <!-- Row 1: Slots 1 & 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Slot 1 Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPageThumb1"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#212121"
                app:cardCornerRadius="12dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/ivPageThumb1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Photo Slot 1" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvDevPhotoTime1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="N/A"
                android:textColor="#AAAAAA"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Slot 2 Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPageThumb2"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#212121"
                app:cardCornerRadius="12dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/ivPageThumb2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Photo Slot 2" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvDevPhotoTime2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="N/A"
                android:textColor="#AAAAAA"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2: Slots 3 & 4 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Slot 3 Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPageThumb3"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#212121"
                app:cardCornerRadius="12dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/ivPageThumb3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Photo Slot 3" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvDevPhotoTime3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="N/A"
                android:textColor="#AAAAAA"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Slot 4 Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPageThumb4"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#212121"
                app:cardCornerRadius="12dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/ivPageThumb4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Photo Slot 4" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvDevPhotoTime4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="N/A"
                android:textColor="#AAAAAA"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
