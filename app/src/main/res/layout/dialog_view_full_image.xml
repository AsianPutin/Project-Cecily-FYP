<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Layer 1: Fullscreen Soft Blurred Profile Picture Background Fill -->
    <ImageView
        android:id="@+id/ivBlurBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Blurred Background"
        android:scaleType="centerCrop" />

    <!-- Layer 2: Semi-Transparent Dark Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#44000000" />

    <!-- Layer 3: Center Crisp Profile Picture Card with Rounded Corners -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="center"
        app:cardCornerRadius="28dp"
        app:cardElevation="16dp"
        app:strokeWidth="0dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivFullImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Full Profile Picture"
            android:scaleType="centerCrop" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Layer 4: Floating Close X Button in Top Right -->
    <ImageButton
        android:id="@+id/btnCloseFullImage"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Close"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:tint="#FFFFFF" />

</FrameLayout>
