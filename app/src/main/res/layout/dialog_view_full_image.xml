<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutBlurRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <!-- Layer 1: Fullscreen Soft Blurred Screen Background Fill -->
    <ImageView
        android:id="@+id/ivBlurBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Blurred Background"
        android:scaleType="centerCrop" />

    <!-- Layer 2: Soft Dark Tint Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000" />

    <!-- Layer 3: Center Crisp Profile Picture Card with Rounded Corners -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardImageHolder"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="center"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="28dp"
        app:cardElevation="16dp"
        app:strokeWidth="0dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivFullImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Full Profile Picture"
            android:scaleType="centerCrop" />

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
