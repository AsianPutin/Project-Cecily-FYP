<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date &amp; Outing Preferences"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Select topics you and your partner love to personalize swipe cards."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Together Mode Food Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Together Mode: Cuisines &amp; Food"
            android:textColor="@color/nav_selected"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chkLocalFood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Malaysian, Street Food &amp; Indian Fare" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chkAsianFood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Japanese (Ramen/Sushi) &amp; Korean BBQ" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chkWesternFood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Western, Italian Pizza &amp; Steaks" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chkMiddleEasternFood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Middle Eastern Mandi &amp; Kebabs" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chkCafes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Cozy Cafes, Souffle Pancakes &amp; Bakery" />

        <!-- Together Mode Activities Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Together Mode: Date Activities &amp; Outings"
            android:textColor="@color/nav_selected"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chkOutdoorNature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Scenic Parks, Waterfront &amp; Beach Picnics" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chkEntertainment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Shopping Malls, Cinema, Arcade, Bowling &amp; Karaoke" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chkCozyCreative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Board Game Cafes, Rooftops &amp; Art Studios" />

        <!-- LDR Games Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="LDR Mode: Co-Op Games"
            android:textColor="@color/nav_selected"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chkCoOpGames"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Co-Op Adventures (It Takes Two, Overcooked)" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chkCasualGames"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Casual &amp; Sandbox (Stardew Valley, Minecraft, Roblox)" />

        <!-- LDR Movies Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="LDR Mode: Movie Watch Parties"
            android:textColor="@color/nav_selected"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chkAnimeMovies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Anime &amp; Ghibli Movies" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chkHorrorMovies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Spooky Horror Movies" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chkRomanceMovies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Romance &amp; K-Dramas" />

    </LinearLayout>
</ScrollView>